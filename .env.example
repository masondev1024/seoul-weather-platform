# Secretless Weather-only template. Copy it to a private local location,
# replace every <required> value, chmod 600, and pass its absolute path with
# ASK_SEOUL_PROD_ENV_FILE. Never place the populated file under Git control.

# Weather collection
KMA_SERVICE_KEY=<required>
KMA_BASE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
ASK_SEOUL_KMA_PLACE_ID=seoul-jongno
ASK_SEOUL_KMA_NX=60
ASK_SEOUL_KMA_NY=127

# Personal Cloudflare R2 and Iceberg REST catalog
STORAGE_BACKEND=r2
R2_BUCKET_NAME=<required>
R2_RAW_PREFIX=raw
R2_ENDPOINT=<required>
R2_ACCESS_KEY_ID=<required>
R2_SECRET_ACCESS_KEY=<required>
R2_DATA_CATALOG_TOKEN=<required>
R2_DATA_CATALOG_URI=<required>
R2_DATA_CATALOG_WAREHOUSE=<required>
TRINO_ICEBERG_CATALOG=iceberg

# Personal Cloudflare D1 and existing Worker read-only smoke
SERVING_CLOUDFLARE_ACCOUNT_ID=<required>
CLOUDFLARE_ACCOUNT_ID=<required>
CLOUDFLARE_API_TOKEN=<required>
SERVING_D1_DATABASE_ID=<required>
SERVING_API_BASE_URL=https://example.workers.dev/api/v1
SERVING_API_SMOKE_TOKEN=<required>

# Airflow and local metadata database
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=<required>
AIRFLOW_ADMIN_EMAIL=admin@example.invalid
AIRFLOW_FERNET_KEY=<required>
AIRFLOW_SECRET_KEY=<required>
AIRFLOW_PUBLIC_PORT=30585
POSTGRES_USER=airflow
POSTGRES_PASSWORD=<required>
POSTGRES_DB=airflow
ASK_SEOUL_AIRFLOW_IMAGE=unused-by-mac-local-build

# Weather/dbt runtime
ASK_SEOUL_SCHEMA=ask_seoul
WEATHER_SCHEMA=weather
DBT_TARGET=prod
SMOKE_SCHEMA=weather

# Mac Trino safety envelope
TRINO_MEMORY_LIMIT=5g
TRINO_TASK_CONCURRENCY=2
TRINO_QUERY_MAX_MEMORY_PER_NODE=800MB
TRINO_MEMORY_HEAP_HEADROOM_PER_NODE=1500MB
TRINO_QUERY_MAX_MEMORY=800MB
TRINO_QUERY_MAX_TOTAL_MEMORY=1200MB
