<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.mason.seoul-weather-daily-quality</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/YOUR_USER/Projects/seoul-weather-platform/.venv/bin/python</string>
		<string>-m</string>
		<string>tools.weather_daily_quality_schedule</string>
		<string>--run</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/YOUR_USER/Projects/seoul-weather-platform</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>17</integer>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>Nice</key>
	<integer>10</integer>
	<key>LowPriorityIO</key>
	<true/>
	<key>Umask</key>
	<integer>63</integer>
	<key>StandardOutPath</key>
	<string>/Users/YOUR_USER/Projects/seoul-weather-platform/logs/weather_daily_quality/scheduler.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/YOUR_USER/Projects/seoul-weather-platform/logs/weather_daily_quality/scheduler-error.log</string>
</dict>
</plist>
