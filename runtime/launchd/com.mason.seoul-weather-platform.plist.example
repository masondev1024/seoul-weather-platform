<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Copy this file to ~/Library/LaunchAgents after replacing YOUR_USER. -->
  <key>Label</key>
  <string>com.mason.seoul-weather-platform</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/YOUR_USER/Projects/seoul-weather-platform/scripts/weather_startup.sh</string>
    <string>--repo-root</string>
    <string>/Users/YOUR_USER/Projects/seoul-weather-platform</string>
    <string>--env-file</string>
    <string>/Users/YOUR_USER/Projects/seoul-weather-platform/weather-platform.prod.env</string>
    <string>--start</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- Change to enabled only after the local target and preflight are approved. -->
    <key>WEATHER_STARTUP_AUTOSTART</key>
    <string>disabled</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>/tmp/seoul-weather-platform-launchd.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/seoul-weather-platform-launchd.err</string>
</dict>
</plist>
